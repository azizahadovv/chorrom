# deploy/.env — serverda shu faylni nusxalab, qiymatlarni to'ldiring (git'ga qo'shilmaydi)

# Baza paroli (uzun tasodifiy satr): openssl rand -hex 24
DB_PASSWORD=
# JWT imzo kaliti (kamida 32 belgi): openssl rand -hex 32
JWT_SECRET=

# Birinchi ishga tushishda yaratiladigan admin (keyin admin paneldan parolni almashtiring)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Ixtiyoriy: Telegram bot tokeni (admin paneldagidan ustun turadi)
TELEGRAM_BOT_TOKEN=

# Ma'lumotlar (baza, rasmlar) va API porti
DATA_DIR=/srv/chorrom
API_PORT=8090
WEB_ROOT=/var/www/chorrom

# Bir martalik: eski Lovable/Supabase bazasidan ochiq ma'lumot va rasmlarni ko'chirish (baza bo'sh bo'lsa).
# Ko'chirilgach bo'shatib qo'yish mumkin.
IMPORT_SUPABASE_URL=https://fyltqyrnvibiwvegnqil.supabase.co
IMPORT_SUPABASE_KEY=

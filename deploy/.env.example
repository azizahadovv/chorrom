# deploy/.env — deploy.sh birinchi ishga tushganda shu fayldan yaratadi va bo'sh parollarni o'zi to'ldiradi.
# Git'ga qo'shilmaydi.

# Sayt domeni (HTTPS sertifikati shu domen va www uchun olinadi)
DOMAIN=chorrom.uz

# auto — 80/443 bo'sh bo'lsa Caddy HTTPS'ni o'zi oladi, band bo'lsa host'dagi nginx ishlatiladi (README)
# caddy / host — aniq tanlash
HTTPS_MODE=auto

# Baza paroli va JWT kaliti. Bo'sh bo'lsa deploy.sh yaratadi.
DB_PASSWORD=
JWT_SECRET=

# Birinchi ishga tushishda yaratiladigan admin. Parol bo'sh bo'lsa deploy.sh yaratadi va ekranga chiqaradi.
ADMIN_EMAIL=admin@chorrom.uz
ADMIN_PASSWORD=

# Ixtiyoriy: Telegram bot tokeni (admin paneldagidan ustun turadi)
TELEGRAM_BOT_TOKEN=

# Sayt konteynerining ichki porti (faqat 127.0.0.1, tashqaridan ko'rinmaydi)
WEB_PORT=8088

# Zaxira nusxalar papkasi (deploy/backup.sh)
BACKUP_DIR=/srv/chorrom-backups

# Bir martalik: eski Lovable/Supabase bazasidan katalog, matnlar va rasmlarni ko'chirish (baza bo'sh bo'lsa).
# Bu ochiq (anon) kalit: eski sayt brauzerida ham ko'rinib turgan. Ko'chirilgach bo'shatib qo'yish mumkin.
IMPORT_SUPABASE_URL=https://fyltqyrnvibiwvegnqil.supabase.co
